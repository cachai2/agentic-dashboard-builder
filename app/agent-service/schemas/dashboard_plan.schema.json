{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DashboardPlan",
  "type": "object",
  "required": [
    "title",
    "description",
    "sections"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "query": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "charts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "layout": {
            "type": "string"
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {"type": "string"},
                "operator": {"type": "string"},
                "value": {}
              },
              "additionalProperties": true
            }
          },
          "charts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "type",
                "query"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "insight": {
                  "type": "string"
                },
                "dataset": {
                  "type": "string"
                },
                "query": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": true
                },
                "options": {
                  "type": "object"
                },
                "annotations": {
                  "type": "object"
                },
                "metrics": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "dimensions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
